enum UserRole {
    CUSTOMER
    ADMIN
}

model User {
    id             String   @id @default(cuid())
    name           String
    email          String   @unique
    role           UserRole @default(CUSTOMER)
    password       String
    balance        Decimal  @db.Decimal(14, 4)
    tokenVersion   Int      @default(0)
    loans          Loan[]   @relation("loan_owner_relation")
    processedLoans Loan[]   @relation("admin_officer_relation")
    tokens         Token[]
    created_at     DateTime @default(now())
    updated_at     DateTime @updatedAt

    @@map("users")
}
